# Dil modelleri ve font ikili (binary) dosyalardır; diff/merge anlamsız.
*.traineddata binary
*.ttf binary
*.otf binary
*.so binary
*.jar binary
*.apk binary
*.aab binary

# Windows'ta satır sonu karışmasın
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.pro text eol=lf
# gradlew bir kabuk betiğidir: LF olmazsa Linux/macOS'ta çalışmaz.
gradlew text eol=lf
*.bat text eol=crlf
gradlew.bat text eol=crlf
